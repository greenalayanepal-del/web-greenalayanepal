# Supabase (required for data and the contact form)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: scripts (apply-phase4.mjs, update-butterfly-db-url.mjs) — never expose in the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: email staff when someone submits the contact form (Resend)
RESEND_API_KEY=re_xxxxxxxx
CONTACT_NOTIFY_EMAIL=info@greenalayanepal.org.np
CONTACT_FROM_EMAIL=Greenalaya Nepal <onboarding@resend.dev>

# After setup, run supabase/phase5.sql for newsletter signups (newsletter_subscribers table)
